# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-...
# NETAGENT_MODEL=claude-opus-5-5
# NETAGENT_EFFORT=medium        # low | medium | high
# დღიური AI ხარჯის ლიმიტი დოლარებში (0 = ლიმიტის გარეშე). ლიმიტის შემდეგ AI ჩერდება,
# /status /cmd /audit /backup /report ისევ მუშაობს.
NETAGENT_DAILY_BUDGET=2

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC...
# მძიმით გამოყოფილი Telegram user ID-ები (ბოტს /id მიწერე, რომ გაიგო შენი)
TELEGRAM_ALLOWED_USERS=

# ---- მოწყობილობების credentials (სახელები inventory/devices.yaml-შია მითითებული) ----
NET_USER=admin
NET_PASS=
NET_ENABLE=
MIKROTIK_USER=admin
MIKROTIK_PASS=

# ---- მონიტორინგი და რეპორტი ----
# რამდენ წუთში ერთხელ შეამოწმოს მოწყობილობები (0 = გამორთული)
NETAGENT_MONITOR_INTERVAL=5
# დღიური რეპორტი + backup (ცარიელი = გამორთული)
NETAGENT_DAILY_REPORT=09:00
NETAGENT_TZ=Asia/Tbilisi
# რამდენ წუთში ერთხელ შეამოწმოს config ცვლილებები (0 = გამორთული)
NETAGENT_CONFIG_WATCH_INTERVAL=60

# ---- სხვა ----
# NETAGENT_INVENTORY=inventory/devices.yaml
# NETAGENT_BACKUP_DIR=backups
# NETAGENT_EXPORT_DIR=exports
# NETAGENT_DATA_DIR=data
# NETAGENT_DEVICE_TIMEOUT=20
# NETAGENT_MAX_PARALLEL=10
