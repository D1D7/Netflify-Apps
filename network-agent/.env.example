# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-...
# NETAGENT_MODEL=claude-opus-5-5
# NETAGENT_EFFORT=medium        # low | medium | high
# დღიური AI ხარჯის ლიმიტი დოლარებში (0 = ლიმიტის გარეშე). ლიმიტის შემდეგ AI ჩერდება,
# /status /cmd /audit /backup /report ისევ მუშაობს.
NETAGENT_DAILY_BUDGET=2

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC...
# მძიმით გამოყოფილი Telegram user ID-ები (ბოტს /id მიწერე, რომ გაიგო შენი)
TELEGRAM_ALLOWED_USERS=

# ---- აპი (Android / კომპიუტერი) ----
# პაროლს და 2FA-ს ჯობია `python -m netagent web-setup`-ით აყენო (ინახება hash-ად).
# NETAGENT_WEB_PASSWORD=
NETAGENT_WEB_HOST=127.0.0.1
NETAGENT_WEB_PORT=8080
# Telegram-იც ჩართული იყოს აპთან ერთად? (on/off; მუშაობს მხოლოდ თუ TELEGRAM_BOT_TOKEN არის)
NETAGENT_TELEGRAM=on

# ---- მოწყობილობების credentials (სახელები inventory/devices.yaml-შია მითითებული) ----
NET_USER=admin
NET_PASS=
NET_ENABLE=
MIKROTIK_USER=admin
MIKROTIK_PASS=

# ---- მონიტორინგი და რეპორტი ----
# რამდენ წუთში ერთხელ შეამოწმოს მოწყობილობები (0 = გამორთული)
NETAGENT_MONITOR_INTERVAL=5
# დღიური რეპორტი + backup (ცარიელი = გამორთული)
NETAGENT_DAILY_REPORT=09:00
NETAGENT_TZ=Asia/Tbilisi
# ინტერფეისების/BGP/OSPF/CPU შემოწმება (მხოლოდ `watch`-იან მოწყობილობებზე), წუთები
NETAGENT_DEEP_MONITOR_INTERVAL=5
# რამდენ წუთში ერთხელ შეამოწმოს config ცვლილებები (0 = გამორთული)
NETAGENT_CONFIG_WATCH_INTERVAL=60
# ARP-ში ახალი (უცნობი) MAC-ების ძებნა, წუთები (0 = გამორთული)
NETAGENT_NEW_DEVICE_INTERVAL=15

# ---- Syslog: მოწყობილობები ლოგებს ამ კომპიუტერზე აგზავნიან (0 = გამორთული) ----
NETAGENT_SYSLOG_PORT=514
# NETAGENT_SYSLOG_HOST=0.0.0.0

# ---- ლოკალური ქსელი და ინტერნეტი (წუთები / საათები, 0 = გამორთული) ----
NETAGENT_HOME_SCAN_INTERVAL=30
NETAGENT_ISP_INTERVAL=1
NETAGENT_SPEEDTEST_INTERVAL=12
# შენი ტარიფი Mbps-ში (რეპორტისა და "ნელია" ალერტისთვის)
# NETAGENT_ISP_PLAN_MBPS=100
NETAGENT_SITE_INTERVAL=5
# გათიშულ მოწყობილობაზე შეხსენება ყოველ N წუთში, სანამ /ack-ს არ დააჭერ
NETAGENT_ESCALATE_MINUTES=15

# ---- ალერტები email-ით / Discord / Slack (არასავალდებულო) ----
# Gmail: smtp.gmail.com, 587, და Google-ის "App password" (არა ჩვეულებრივი პაროლი)
# NETAGENT_SMTP_HOST=smtp.gmail.com
# NETAGENT_SMTP_PORT=587
# NETAGENT_SMTP_USER=
# NETAGENT_SMTP_PASS=
# NETAGENT_EMAIL_TO=
# NETAGENT_EMAIL_KINDS=down,escalation,isp,site,syslog,newdevice,report,scheduled,watch,config
# NETAGENT_DISCORD_WEBHOOK=
# NETAGENT_SLACK_WEBHOOK=

# ---- ინტერფეისები, CVE, backup ისტორია ----
NETAGENT_TRAFFIC_INTERVAL=5
NETAGENT_BACKUP_GIT=on
# NVD_API_KEY=        # nvd.nist.gov/developers/request-an-api-key (არასავალდებულო)

# ---- კონფიგურაციის ცვლილებები (ნაგულისხმევად გამორთული) ----
# ჩართვა: on, შემდეგ PIN: python -m netagent change-pin
NETAGENT_CHANGES=off
# NETAGENT_CHANGE_RELOAD_GUARD=on

# ---- NetFlow / SNMP / Grafana / იმპორტი ----
NETAGENT_FLOW_PORT=2055
# SNMP_COMMUNITY=public
# NETAGENT_SNMP_INTERVAL=10
# NETAGENT_METRICS_TOKEN=
# NETBOX_URL=
# NETBOX_TOKEN=
# ZABBIX_URL=
# ZABBIX_TOKEN=

# ---- სხვა ----
# NETAGENT_INVENTORY=inventory/devices.yaml
# NETAGENT_BACKUP_DIR=backups
# NETAGENT_EXPORT_DIR=exports
# NETAGENT_DATA_DIR=data
# NETAGENT_DEVICE_TIMEOUT=20
# NETAGENT_MAX_PARALLEL=10

# --- internet quality, DNS filter, morning summary, Home Assistant ---
# NETAGENT_AUTO_INVENTORY=on            # add routers/switches to devices.yaml when they join the network
# NETAGENT_WIFI_LOG_INTERVAL=5          # minutes between Wi-Fi signal samples (0 = off)
# NETAGENT_DNS=off                      # on = DNS ad/malware blocking server on this PC (point the router's DNS here)
# NETAGENT_DNS_PORT=53
# NETAGENT_DNS_UPSTREAM=1.1.1.1,8.8.8.8
# NETAGENT_DNS_LISTS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
# NETAGENT_MORNING=08:00                # morning summary push time (off = disabled)
# NETAGENT_MQTT=                        # Home Assistant MQTT broker, e.g. 192.168.1.10 or 192.168.1.10:1883
# NETAGENT_MQTT_USER=
# NETAGENT_MQTT_PASS=
# NETAGENT_MQTT_PREFIX=homeassistant
